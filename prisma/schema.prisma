// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role-based access control for TaskerAI
// EMPLOYEE: Default role. Can create/edit/delete own or assigned tasks, comment, update status/priority/due dates.
// ADMIN: High permissions. Can invite/remove members (except Owner), create/edit/archive projects, manage all tasks.
// OWNER: Full control. Can invite/remove/change role of anyone, delete workspace, manage everything.
enum Role {
  EMPLOYEE
  ADMIN
  OWNER
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  country             String?
  city                String?
  province            String?
  barangay            String?
  zipCode             String?
  dateOfBirth         DateTime?
  role                Role      @default(EMPLOYEE)
  isVerified          Boolean   @default(false)
  active              Boolean   @default(false)
  lastActive          DateTime?
  profilePicture      String?
  emailNotifications  Boolean   @default(true)
  messageNotifications Boolean  @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  createdTasks        Task[]    @relation("CreatedTasks")
  assignedTasks       TaskAssignee[]  @relation("TaskAssignees")
  comments            Comment[]
  channelMembers      ChannelMember[]
  channelEditors      ChannelEditor[]
  createdChannels     Channel[] @relation("ChannelCreator")
  messages            Message[]
  sentDirectMessages  DirectMessage[] @relation("SentDirectMessages")
  receivedDirectMessages DirectMessage[] @relation("ReceivedDirectMessages")
  notifications       Notification[]
  logs                Log[]
  auditLogs           AuditLog[] @relation("AuditLogs")
  
  ownedTeams          Team[]    @relation("TeamOwner")
  teamMemberships     TeamMember[]
  invitedMembers      TeamMember[] @relation("TeamMemberInviter")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("todo")
  priority    String?  
  createdById String
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deadlineNotificationSentAt DateTime? // Track when deadline notification was last sent

  createdBy   User @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  assignees   TaskAssignee[] @relation("TaskAssignees")
  comments    Comment[]
  attachments Attachment[]
}

model TaskAssignee {
  id          String   @id @default(uuid())
  taskId      String
  assigneeId  String
  assignedAt  DateTime @default(now())

  task        Task @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User @relation("TaskAssignees", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    String
  userId    String?
  content   String
  parentCommentId Int?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  replies Comment[] @relation("CommentReplies")
  parentComment Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  taskId    String
  url       String
  filename  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
}

model Channel {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  isPrivate       Boolean   @default(false)
  creatorId       String
  profilePicture  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator         User @relation("ChannelCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members         ChannelMember[]
  editors         ChannelEditor[]
  messages        Message[]
}

model ChannelMember {
  id        Int      @id @default(autoincrement())
  userId    String
  channelId Int
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelEditor {
  id        Int      @id @default(autoincrement())
  userId    String
  channelId Int
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id              Int       @id @default(autoincrement())
  channelId       Int?
  senderId        String
  content         String
  attachments     String[]
  reactions       Json[]
  isEdited        Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  parentMessageId Int?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  updatedAt       DateTime  @updatedAt

  channel         Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parentMessage   Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[] @relation("MessageReplies")
}

model DirectMessage {
  id        Int      @id @default(autoincrement())
  senderId  String
  recipientId String
  content   String
  attachments String[]
  reactions Json[]
  isRead    Boolean @default(false)
  parentMessageId Int?
  createdAt DateTime @default(now())

  sender    User @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  parentMessage DirectMessage? @relation("DirectMessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies DirectMessage[] @relation("DirectMessageReplies")

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, isRead])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  receiverId String
  type      String
  data      Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  receiver  User @relation(fields: [receiverId], references: [id], onDelete: Cascade)
}

model Log {
  id        Int      @id @default(autoincrement())
  taskId    String?
  userId    String
  action    String
  data      Json?
  createdAt DateTime @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    String
  inviterId String?     // User who added this member
  status    String   @default("active") // "active", "inactive"
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter  User? @relation("TeamMemberInviter", fields: [inviterId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     String?
  action     String
  resource   String
  resourceId Int?
  details    Json     @default("{}")
  ipAddress  String   @default("")
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  user   User? @relation("AuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resourceId])
  @@index([createdAt])
}
