{
  "name": "boombox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "powershell -Command \"try { $p = Get-NetTCPConnection -LocalPort 3000 -ErrorAction Stop; if ($p) { Stop-Process -Id $p.OwningProcess -Force } } catch {}; next dev\"",
    "dev:kill": "powershell -Command \"try { $p = Get-NetTCPConnection -LocalPort 3000 -ErrorAction Stop; if ($p) { Stop-Process -Id $p.OwningProcess -Force; Write-Host 'Killed process using port 3000' } else { Write-Host 'No process using port 3000' } } catch { Write-Host 'No process using port 3000' }\"}",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node --import ./ts-node-loader.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@huggingface/inference": "^4.13.10",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.562.0",
    "next": "^15.4.6",
    "nodemailer": "^8.0.1",
    "prisma": "^5.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.7.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "ts-node": {
    "esm": true
  }
}
